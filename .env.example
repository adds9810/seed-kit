# Public variables (exposed to browser bundle)
# Use an absolute origin without trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: custom social account for metadata
NEXT_PUBLIC_TWITTER_HANDLE=@seedkit

# -----------------------------------------------------------------------------
# Rules
# 1) Variables starting with NEXT_PUBLIC_ are readable in client-side code.
# 2) Never store secrets with NEXT_PUBLIC_ prefix.
# 3) Keep secrets only in server-only variables (without NEXT_PUBLIC_).
# -----------------------------------------------------------------------------
